# Copy to .env for local runs (`cp .env.example .env`). Every variable is optional and has a
# safe development default; see src/hookrelay/core/config.py for validation rules.

# development | test | production  (production enforces JSON logs, no DEBUG, no DB_ECHO)
APP_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=8000
DOCS_ENABLED=true

# Logging: json | console
LOG_FORMAT=console
LOG_LEVEL=INFO

# Postgres (source of truth). postgres://, postgresql:// and postgresql+asyncpg:// are accepted;
# the asyncpg driver is always used. docker compose exposes Postgres on localhost:5432.
DATABASE_URL=postgresql+asyncpg://hookrelay:hookrelay@localhost:5432/hookrelay
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_S=5
DB_POOL_RECYCLE_S=1800
DB_CONNECT_TIMEOUT_S=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_ECHO=false

# /ready gives up on Postgres after this many seconds and returns 503
READINESS_TIMEOUT_S=2

# Redis (used from Milestone 6: wake-ups, caching, rate limits). Empty = disabled.
REDIS_URL=redis://localhost:6379/0

# Header used to accept/return the request correlation ID
REQUEST_ID_HEADER=X-Request-ID

# Integration tests only: a role that may CREATE DATABASE (tests create and drop scratch DBs)
TEST_DATABASE_URL=postgresql://hookrelay:hookrelay@localhost:5432/hookrelay
