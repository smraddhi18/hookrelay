# All values here are fake, local-only examples. Never commit real secrets; set them in your
# deployment environment. The docker-compose defaults are also fake and local-only-not-for-prod.

# Copy to .env for local runs (`cp .env.example .env`). Every variable is optional and has a
# safe development default; see src/hookrelay/core/config.py for validation rules.

# development | test | production  (production enforces JSON logs, no DEBUG, no DB_ECHO)
APP_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=8000
DOCS_ENABLED=true
# Seconds uvicorn lets in-flight requests finish after SIGTERM (Kubernetes: keep
# terminationGracePeriodSeconds > preStop sleep + this; the Helm chart enforces it).
API_GRACEFUL_SHUTDOWN_S=20

# Logging: json | console
LOG_FORMAT=console
LOG_LEVEL=INFO

# Postgres (source of truth). postgres://, postgresql:// and postgresql+asyncpg:// are accepted;
# the asyncpg driver is always used. docker compose exposes Postgres on localhost:5432.
DATABASE_URL=postgresql+asyncpg://hookrelay:hookrelay@localhost:5432/hookrelay
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_S=5
DB_POOL_RECYCLE_S=1800
DB_CONNECT_TIMEOUT_S=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_ECHO=false
# Milestone 9: set true when DATABASE_URL points at PgBouncer in transaction pooling mode
# (compose: postgresql+asyncpg://hookrelay:hookrelay@pgbouncer:6432/hookrelay). asyncpg's
# statement caches are then off and statement names unique; DB_STATEMENT_TIMEOUT_MS is only
# enforced client-side, so configure the server-side timeouts on the pooler (connect_query, see
# deploy/pgbouncer/pgbouncer.ini) or as role defaults.
DB_PGBOUNCER=false
# Postgres itself, bypassing any pooler: Alembic uses it (required when DB_PGBOUNCER=true).
# DATABASE_DIRECT_URL=postgresql+asyncpg://hookrelay:hookrelay@localhost:5432/hookrelay

# /ready gives up on Postgres after this many seconds and returns 503
READINESS_TIMEOUT_S=2

# Redis (Milestone 6: wake-ups, subscription cache, Lua rate limits). Empty = disabled;
# every feature then degrades to the Postgres path (workers poll, fan-out joins in SQL,
# rate limits stay inside the lease transaction). Never fail open.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=hookrelay
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_COMMAND_TIMEOUT_MS=500
REDIS_RECONNECT_BASE_MS=100
REDIS_RECONNECT_MAX_MS=5000
# Soft by default: Redis down is reported on /ready but does not 503 the API.
REDIS_REQUIRED_FOR_READY=false
# Feature toggles default on when REDIS_URL is set; set false to force-disable one.
# WAKEUP_ENABLED=
# SUBSCRIPTION_CACHE_ENABLED=
# RATE_LIMIT_REDIS_ENABLED=
WAKEUP_COALESCE_MS=50
SUBSCRIPTION_CACHE_TTL_S=60

# Header used to accept/return the request correlation ID
REQUEST_ID_HEADER=X-Request-ID

# Operator (platform admin) API under /admin: create / get / suspend tenants and issue their
# first API key. At least 32 characters; empty = every /admin call returns 403.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATOR_TOKEN=

# AES-256-GCM key for endpoint signing secrets at rest: base64/base64url of 32 random bytes.
# Required when APP_ENV=production; empty in development = a fixed, insecure dev key.
#   python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRETS_ENCRYPTION_KEY=
# During a key rotation put the old key here: it can still decrypt, new writes use the primary.
SECRETS_ENCRYPTION_KEY_PREVIOUS=

# Tenant API keys: how long the old key keeps working after a rotation (0..604800 s), and the
# minimum interval between last_used_at writes per key (0 = every request).
API_KEY_ROTATION_OVERLAP_S=86400
API_KEY_LAST_USED_RESOLUTION_S=60

# Webhook endpoints. Production should keep https-only and public-network-only targets.
# ENDPOINT_ALLOW_HTTP is also what lets the delivery worker send over plain http.
ENDPOINT_ALLOW_HTTP=false
ENDPOINT_ALLOW_PRIVATE_NETWORKS=false
# Per-endpoint delivery timeout: default and upper bound (1000..60000 ms)
ENDPOINT_DEFAULT_TIMEOUT_MS=10000
ENDPOINT_MAX_TIMEOUT_MS=30000

# Event ingestion (POST /v1/events). Max canonical JSON size of `payload` (1024..10485760);
# the whole request may be 16 KiB larger for the envelope. Oversized requests get 413.
EVENT_MAX_PAYLOAD_BYTES=262144
# How far in the future a client-supplied occurred_at may be (clock skew allowance), seconds
EVENT_OCCURRED_AT_MAX_FUTURE_S=300
# Events (and their deliveries) are purged by the relay this many days after acceptance
EVENT_RETENTION_DAYS=30

# Idempotency-Key: how long a key is remembered (60..604800 s), and how long a request waits
# for a concurrent request holding the same key before answering 409 + Retry-After.
IDEMPOTENCY_KEY_TTL_S=86400
IDEMPOTENCY_LOCK_TIMEOUT_MS=2000

# Fan-out relay (`python -m hookrelay.relay`): outbox rows claimed per transaction, idle
# polling backoff bounds, retry cap for a failing outbox row, housekeeping cadence, how long
# processed outbox rows are kept, and the heartbeat file used by `--healthcheck`.
RELAY_BATCH_SIZE=100
RELAY_POLL_MIN_MS=100
RELAY_POLL_MAX_MS=2000
RELAY_RETRY_MAX_S=300
RELAY_HOUSEKEEPING_INTERVAL_S=60
RELAY_OUTBOX_RETENTION_S=3600
RELAY_HEARTBEAT_FILE=/tmp/hookrelay-relay.heartbeat
RELAY_HEARTBEAT_MAX_AGE_S=60

# Delivery worker (`python -m hookrelay.worker`). WORKER_ID defaults to host:pid:random and
# appears on every attempt row. CONCURRENCY caps in-flight HTTP requests per process;
# BATCH_SIZE caps leases per poll (never more than the free slots). A lease lasts LEASE_S and
# is renewed every LEASE_RENEW_INTERVAL_S (at most half of LEASE_S); expired leases are
# reclaimed every RECLAIM_INTERVAL_S. On SIGTERM in-flight attempts get DRAIN_TIMEOUT_S to
# finish, then their leases are released unspent (keep it below the orchestrator's grace).
WORKER_ID=
WORKER_CONCURRENCY=16
WORKER_BATCH_SIZE=50
WORKER_POLL_MIN_MS=100
WORKER_POLL_MAX_MS=2000
# When saturated, wait up to this long for ~1/4 of the slots to free before re-leasing (0 = off).
WORKER_REFILL_LINGER_MS=20
WORKER_LEASE_S=60
WORKER_LEASE_RENEW_INTERVAL_S=15
WORKER_RECLAIM_INTERVAL_S=10
WORKER_DRAIN_TIMEOUT_S=25
# A completion (status + attempt row + breaker) that hits a transient DB error (connection
# terminated, failover, pool timeout) is retried COMPLETE_RETRIES times with exponential
# backoff from COMPLETE_RETRY_BASE_MS capped at COMPLETE_RETRY_MAX_MS, so a Postgres restart
# right after a receiver's 2xx does not cause a redelivery. The lease-token fence makes the
# retry idempotent. 0 disables it (the lease then expires and the reaper retries).
WORKER_COMPLETE_RETRIES=6
WORKER_COMPLETE_RETRY_BASE_MS=100
WORKER_COMPLETE_RETRY_MAX_MS=2000
# Group commit (Milestone 9): finished attempts are written up to BATCH_MAX per transaction,
# each row still fenced by its own lease token. A batch is written when full, when every
# in-flight attempt is waiting on it, or BATCH_LINGER_MS after its oldest entry arrived.
# BATCH_MAX=1 is one transaction per attempt (the pre-M9 behaviour).
WORKER_COMPLETE_BATCH_MAX=32
WORKER_COMPLETE_BATCH_LINGER_MS=5
WORKER_HEARTBEAT_FILE=/tmp/hookrelay-worker.heartbeat
WORKER_HEARTBEAT_MAX_AGE_S=60

# Outbound webhooks. The per-endpoint timeout_ms bounds the whole request; CONNECT_TIMEOUT_MS
# bounds the TCP/TLS handshake. At most RESPONSE_MAX_BYTES of a response body is read and kept
# in the attempt log (0..65536). Retries use full-jitter exponential backoff
# (BACKOFF_BASE_S * 2^(n-1), capped at BACKOFF_MAX_S); a receiver's Retry-After is honoured as
# a floor up to RETRY_AFTER_MAX_S. A retryable delivery is dead-lettered (`dead`) after
# MAX_ATTEMPTS attempts in its current run, or when the next attempt would land later than
# MAX_AGE_S after the run started (a replay starts a new run); permanent errors end `failed`.
DELIVERY_CONNECT_TIMEOUT_MS=5000
DELIVERY_RESPONSE_MAX_BYTES=4096
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_MAX_AGE_S=259200
DELIVERY_BACKOFF_BASE_S=5
DELIVERY_BACKOFF_MAX_S=3600
DELIVERY_RETRY_AFTER_MAX_S=3600
# SSRF guard: destination ports the worker may connect to (comma-separated)
DELIVERY_ALLOWED_PORTS=80,443,8080,8443
# Lets the worker reach loopback / RFC 1918 / CGNAT receivers for local testing. Refused when
# APP_ENV=production; link-local and cloud metadata addresses are blocked regardless.
DELIVERY_ALLOW_PRIVATE_NETWORKS=false

# Back-pressure (per endpoint, enforced in Postgres at lease time). An endpoint without its own
# max_in_flight gets DEFAULT_MAX_IN_FLIGHT concurrent attempts across all workers; tenants may
# set max_in_flight up to ENDPOINT_MAX_IN_FLIGHT and rate_limit_per_s up to
# ENDPOINT_MAX_RATE_LIMIT_PER_S (token bucket, burst = one second's worth).
ENDPOINT_DEFAULT_MAX_IN_FLIGHT=10
ENDPOINT_MAX_IN_FLIGHT=100
ENDPOINT_MAX_RATE_LIMIT_PER_S=1000
# Circuit breaker: FAILURE_THRESHOLD consecutive availability failures (5xx, 408, 429,
# timeouts, connection/DNS/TLS errors) open it for COOLDOWN_BASE_S * 2^trips (capped at
# COOLDOWN_MAX_S); then one half-open probe decides. Deliveries wait in `pending` meanwhile
# without spending attempts.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_BASE_S=30
BREAKER_COOLDOWN_MAX_S=600
# An endpoint failing continuously for this long is disabled and an `endpoint.disabled`
# notification is queued (0 turns auto-disable off). Re-enabling resets the breaker.
ENDPOINT_AUTO_DISABLE_AFTER_S=259200

# Replay API: per-tenant requests per minute, deliveries per request (the response says
# has_more when there were more), and the widest bulk-replay time window.
REPLAY_RATE_LIMIT_PER_MINUTE=30
REPLAY_MAX_DELIVERIES=1000
REPLAY_MAX_WINDOW_S=604800

# Operator notifications (dispatched by the relay; the default notifier logs a WARNING line).
NOTIFICATION_POLL_INTERVAL_S=5
NOTIFICATION_MAX_ATTEMPTS=10
NOTIFICATION_RETENTION_S=604800

# Endpoint signing-secret rotation: default and longest dual-signing overlap (seconds) during
# which the replaced secret still signs as a second v1 signature. 0 = immediate cutover.
ENDPOINT_SECRET_ROTATION_OVERLAP_S=86400
ENDPOINT_SECRET_MAX_OVERLAP_S=604800

# Endpoint health summary (GET /v1/endpoints/{id}/health): default and widest window, and the
# most recent attempts one request reads (the response reports sampled=true past this).
ENDPOINT_HEALTH_DEFAULT_WINDOW_S=86400
ENDPOINT_HEALTH_MAX_WINDOW_S=604800
ENDPOINT_HEALTH_MAX_ATTEMPTS=10000

# Retention. Payloads (and stored receiver response bodies) are dropped this many days after
# the event once all its deliveries are terminal; must be < EVENT_RETENTION_DAYS, 0 = keep
# until the whole event expires. The job (python -m hookrelay.retention, also one bounded
# pass per relay housekeeping run) works in batches of RETENTION_BATCH_SIZE rows, one short
# transaction each, at most RETENTION_MAX_BATCHES per task per run, pausing between batches.
EVENT_PAYLOAD_RETENTION_DAYS=0
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES=200
RETENTION_BATCH_PAUSE_MS=50

# Partition maintenance (Milestone 9c): `hookrelay-partitions` (hourly CronJob in the Helm
# chart, `docker compose run --rm partitions` locally) keeps daily delivery_attempts partitions
# PARTITION_PREMAKE_DAYS ahead (UTC) and detaches + drops partitions whose day is older than
# PARTITION_RETENTION_DAYS (0 = EVENT_RETENTION_DAYS; may not be lower). Single runner via an
# advisory lock; connects with DATABASE_DIRECT_URL when DB_PGBOUNCER=true. DDL waits at most
# PARTITION_LOCK_TIMEOUT_MS for a lock, retried PARTITION_DDL_RETRIES times.
PARTITION_PREMAKE_DAYS=7
PARTITION_RETENTION_DAYS=0
PARTITION_LOCK_TIMEOUT_MS=2000
PARTITION_DDL_RETRIES=5


# --------------------------------------------------------------------------- Observability (M7)
# Prometheus scrape endpoint GET /metrics is unauthenticated by default (scrape-network
# assumption). Set METRICS_TOKEN to require Authorization: Bearer <token>. Never exposes
# tenant payloads. METRICS_PORT starts a side-car scrape HTTP server on relay/worker (0/unset
# = off; the API always serves /metrics on its main port).
METRICS_ENABLED=true
# METRICS_TOKEN=
# METRICS_PORT=0

# OpenTelemetry: off unless an OTLP HTTP endpoint is set. Accepts OTEL_EXPORTER_OTLP_ENDPOINT
# or TRACING_OTLP_ENDPOINT (the latter wins). Compose points at the Jaeger all-in-one service.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# TRACING_OTLP_ENDPOINT=
# TRACING_ENABLED=
# TRACING_SERVICE_NAME=hookrelay
TRACING_SAMPLE_RATIO=1

# Tenant dashboard GET /v1/dashboard (reader+): default / max window and attempt sample cap.
DASHBOARD_DEFAULT_WINDOW_S=3600
DASHBOARD_MAX_WINDOW_S=604800
DASHBOARD_MAX_ATTEMPTS=50000

# Integration tests only: a role that may CREATE DATABASE (tests create and drop scratch DBs)
TEST_DATABASE_URL=postgresql://hookrelay:hookrelay@localhost:5432/hookrelay
# Integration tests behind PgBouncer (tests/integration/test_pgbouncer.py; skipped when unset).
# `bash deploy/pgbouncer/run-test-pooler.sh` starts a matching pooler and prints this URL.
# TEST_PGBOUNCER_URL=postgresql://hookrelay:hookrelay@127.0.0.1:6439/postgres
