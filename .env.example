# Copy to .env for local runs (`cp .env.example .env`). Every variable is optional and has a
# safe development default; see src/hookrelay/core/config.py for validation rules.

# development | test | production  (production enforces JSON logs, no DEBUG, no DB_ECHO)
APP_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=8000
DOCS_ENABLED=true

# Logging: json | console
LOG_FORMAT=console
LOG_LEVEL=INFO

# Postgres (source of truth). postgres://, postgresql:// and postgresql+asyncpg:// are accepted;
# the asyncpg driver is always used. docker compose exposes Postgres on localhost:5432.
DATABASE_URL=postgresql+asyncpg://hookrelay:hookrelay@localhost:5432/hookrelay
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_S=5
DB_POOL_RECYCLE_S=1800
DB_CONNECT_TIMEOUT_S=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_ECHO=false

# /ready gives up on Postgres after this many seconds and returns 503
READINESS_TIMEOUT_S=2

# Redis (used from Milestone 6: wake-ups, caching, rate limits). Empty = disabled.
REDIS_URL=redis://localhost:6379/0

# Header used to accept/return the request correlation ID
REQUEST_ID_HEADER=X-Request-ID

# Operator (platform admin) API under /admin: create / get / suspend tenants and issue their
# first API key. At least 32 characters; empty = every /admin call returns 403.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATOR_TOKEN=

# AES-256-GCM key for endpoint signing secrets at rest: base64/base64url of 32 random bytes.
# Required when APP_ENV=production; empty in development = a fixed, insecure dev key.
#   python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRETS_ENCRYPTION_KEY=
# During a key rotation put the old key here: it can still decrypt, new writes use the primary.
SECRETS_ENCRYPTION_KEY_PREVIOUS=

# Tenant API keys: how long the old key keeps working after a rotation (0..604800 s), and the
# minimum interval between last_used_at writes per key (0 = every request).
API_KEY_ROTATION_OVERLAP_S=86400
API_KEY_LAST_USED_RESOLUTION_S=60

# Webhook endpoints. Production should keep https-only and public-network-only targets.
# ENDPOINT_ALLOW_HTTP is also what lets the delivery worker send over plain http.
ENDPOINT_ALLOW_HTTP=false
ENDPOINT_ALLOW_PRIVATE_NETWORKS=false
# Per-endpoint delivery timeout: default and upper bound (1000..60000 ms)
ENDPOINT_DEFAULT_TIMEOUT_MS=10000
ENDPOINT_MAX_TIMEOUT_MS=30000

# Event ingestion (POST /v1/events). Max canonical JSON size of `payload` (1024..10485760);
# the whole request may be 16 KiB larger for the envelope. Oversized requests get 413.
EVENT_MAX_PAYLOAD_BYTES=262144
# How far in the future a client-supplied occurred_at may be (clock skew allowance), seconds
EVENT_OCCURRED_AT_MAX_FUTURE_S=300
# Events (and their deliveries) are purged by the relay this many days after acceptance
EVENT_RETENTION_DAYS=30

# Idempotency-Key: how long a key is remembered (60..604800 s), and how long a request waits
# for a concurrent request holding the same key before answering 409 + Retry-After.
IDEMPOTENCY_KEY_TTL_S=86400
IDEMPOTENCY_LOCK_TIMEOUT_MS=2000

# Fan-out relay (`python -m hookrelay.relay`): outbox rows claimed per transaction, idle
# polling backoff bounds, retry cap for a failing outbox row, housekeeping cadence, how long
# processed outbox rows are kept, and the heartbeat file used by `--healthcheck`.
RELAY_BATCH_SIZE=100
RELAY_POLL_MIN_MS=100
RELAY_POLL_MAX_MS=2000
RELAY_RETRY_MAX_S=300
RELAY_HOUSEKEEPING_INTERVAL_S=60
RELAY_OUTBOX_RETENTION_S=3600
RELAY_HEARTBEAT_FILE=/tmp/hookrelay-relay.heartbeat
RELAY_HEARTBEAT_MAX_AGE_S=60

# Delivery worker (`python -m hookrelay.worker`). WORKER_ID defaults to host:pid:random and
# appears on every attempt row. CONCURRENCY caps in-flight HTTP requests per process;
# BATCH_SIZE caps leases per poll (never more than the free slots). A lease lasts LEASE_S and
# is renewed every LEASE_RENEW_INTERVAL_S (at most half of LEASE_S); expired leases are
# reclaimed every RECLAIM_INTERVAL_S. On SIGTERM in-flight attempts get DRAIN_TIMEOUT_S to
# finish, then their leases are released unspent (keep it below the orchestrator's grace).
WORKER_ID=
WORKER_CONCURRENCY=16
WORKER_BATCH_SIZE=50
WORKER_POLL_MIN_MS=100
WORKER_POLL_MAX_MS=2000
WORKER_LEASE_S=60
WORKER_LEASE_RENEW_INTERVAL_S=15
WORKER_RECLAIM_INTERVAL_S=10
WORKER_DRAIN_TIMEOUT_S=25
WORKER_HEARTBEAT_FILE=/tmp/hookrelay-worker.heartbeat
WORKER_HEARTBEAT_MAX_AGE_S=60

# Outbound webhooks. The per-endpoint timeout_ms bounds the whole request; CONNECT_TIMEOUT_MS
# bounds the TCP/TLS handshake. At most RESPONSE_MAX_BYTES of a response body is read and kept
# in the attempt log (0..65536). Retries use full-jitter exponential backoff
# (BACKOFF_BASE_S * 2^(n-1), capped at BACKOFF_MAX_S); a receiver's Retry-After is honoured as
# a floor up to RETRY_AFTER_MAX_S. A delivery becomes `failed` after MAX_ATTEMPTS attempts or
# when the next attempt would land later than MAX_AGE_S after the event was accepted.
DELIVERY_CONNECT_TIMEOUT_MS=5000
DELIVERY_RESPONSE_MAX_BYTES=4096
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_MAX_AGE_S=259200
DELIVERY_BACKOFF_BASE_S=5
DELIVERY_BACKOFF_MAX_S=3600
DELIVERY_RETRY_AFTER_MAX_S=3600
# SSRF guard: destination ports the worker may connect to (comma-separated)
DELIVERY_ALLOWED_PORTS=80,443,8080,8443
# Lets the worker reach loopback / RFC 1918 / CGNAT receivers for local testing. Refused when
# APP_ENV=production; link-local and cloud metadata addresses are blocked regardless.
DELIVERY_ALLOW_PRIVATE_NETWORKS=false

# Integration tests only: a role that may CREATE DATABASE (tests create and drop scratch DBs)
TEST_DATABASE_URL=postgresql://hookrelay:hookrelay@localhost:5432/hookrelay
